#include <stdio.h>
#include <unistd.h>
#include "io.h"
#include "system.h"

int main() {
    int val_capteurs;
    int seuil = 220; // Ajuste cette valeur pour la sensibilité

    printf("--- Robot en Action ---\n");

    while(1) {
        // 1. On écrit le seuil : cela génère l'impulsion 'write'
        // qui déclenche data_capture dans le VHDL
        IOWR(ADC_CORE_0_BASE, 0, seuil);

        // 2. On laisse un micro-délai pour la conversion SPI
        usleep(100);

        // 3. On lit le résultat rafraîchi
        val_capteurs = IORD(ADC_CORE_0_BASE, 0);

        // Affichage binaire pour voir les 7 capteurs
        printf("Capteurs : ");
        int i;
        for (i = 6; i >= 0; i--) {
            printf("%c", (val_capteurs & (1 << i)) ? '1' : '.');
        }
        printf(" (Raw: 0x%02X)\r\n", val_capteurs);

        usleep(10000); // 10ms de pause (100Hz) pour la réactivité
    }
    return 0;
}
